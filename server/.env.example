# Server configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/thepointoneclub
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed credentials for the initial admin user
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@thepointone.club
ADMIN_PASSWORD=pointone2024
ADMIN_NAME=Point One Admin

# Demo access gate. When empty, the site is fully open (local dev).
# Set a value in production to require a code before anything loads.
DEMO_ACCESS_CODE=
DEMO_ACCESS_EXPIRES_IN=12h
